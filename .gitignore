node_modules/
dist/
samples/
.DS_Store
._*
*.local

# Local environment secrets; keep sanitized templates publishable.
.env
.env.*
!.env.example
!.env.template

# Disposable browser/test output, separate from docs/img design references.
/.playwright-mcp/
/playwright-report/
/test-results/
/assets-tests/
/coverage/
*.tsbuildinfo

# Generated output stays local; these approved teaching PNGs are runtime assets.
/output/*
!/output/imagens-ip-route-sem-setas/
!/output/imagens-rotas-estaticas-referencia/
/output/imagens-ip-route-sem-setas/*
!/output/imagens-ip-route-sem-setas/ip-route-de.png
!/output/imagens-ip-route-sem-setas/ip-route-en.png
!/output/imagens-ip-route-sem-setas/ip-route-pt-BR.png
/output/imagens-rotas-estaticas-referencia/*
!/output/imagens-rotas-estaticas-referencia/rota-estatica-de.png
!/output/imagens-rotas-estaticas-referencia/rota-estatica-en.png
!/output/imagens-rotas-estaticas-referencia/rota-estatica-pt-BR.png

# Local logs and scratch files; do not hide test fixtures in source folders.
/*.log
/logs/
/*.tmp
/*.bak

# Personal editor configuration; shared extension recommendations may be kept.
/.idea/
/.vscode/*
!/.vscode/extensions.json

# Local-only terminal visual experiments; functional renderer code stays tracked.
/docs/img/aurora-flow-four-panels.png
/docs/img/aurora-flow-grouped.png
/docs/img/terminal-effects/*.png
